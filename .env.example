NODE_ENV=development
HOST=127.0.0.1
PORT=4000
FRONTEND_ORIGINS=http://localhost:5173

# Add real credentials only to your local .env or deployment secrets.
# Never commit .env or production credentials.
DATABASE_URL=""
SESSION_SECRET=
EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER_API_KEY=

# Brevo transactional email (use a verified sender in Brevo)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=U-Pay

# Use a random secret with at least 32 characters.
# Keep the same value across backend restarts and deployments.
OTP_HASH_SECRET=
